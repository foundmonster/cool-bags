# Environment Variables Template
# Copy these variable names to Netlify dashboard (Site settings > Environment variables)
# These are the only variables the code reads - all three are used by
# netlify/functions/create-issue.js

# Required - GitHub Personal Access Token used to open issues on foundmonster/cool-bags
GITHUB_TOKEN=your_github_personal_access_token_here

# Optional - Mailgun private API key; without it the brand-request confirmation email is skipped
MAILGUN_API_KEY=your_mailgun_private_api_key_here

# Optional - Mailgun sending domain, e.g. mg.coolbags.info; required whenever MAILGUN_API_KEY is set
MAILGUN_DOMAIN=your_mailgun_sending_domain_here

# BUTTONDOWN_API_KEY is not read by any code in this repo's functions. It is a GitHub Actions
# repository secret used by .github/workflows/notify-brand-added.yml. It is also set as a Netlify
# project variable, where nothing consumes it.
